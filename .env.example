# Supabase 프로젝트 > Project Settings > API
# 값을 채운 뒤 .env.local 로 복사한다. 비워 두면 앱은 기본 플랜 목록으로 동작한다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 한국수출입은행 환율 Open API 인증키 (무료).
# https://www.koreaexim.go.kr/ir/HPHKIR019M01 에서 발급받는다.
# 비워 두면 카드 청구액 추정 없이 직접 입력만 된다.
KOREAEXIM_API_KEY=
